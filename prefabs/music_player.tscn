[sub_resource type="GDScript" id="GDScript_3owqy"]
script/source = "extends Node

@onready var a_player = $AudioStreamPlayer

var target_volume = -15
const change_speed = 0.3

func _ready():
	a_player.play()

func _process(delta):
	var volume = a_player.volume_db
	
	var volume_change = (target_volume - volume) * delta * change_speed
	
	a_player.volume_db += volume_change

func set_target_volume(value):
	target_volume = value

func stop():
	a_player.stream_paused = true

func start():
	a_player.stream_paused = false
"

