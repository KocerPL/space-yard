[sub_resource type="GDScript" id="GDScript_3owqy"]
script/source = "extends Node

@onready var main_track_player = $MainTrack
@onready var tense_track_player = $TenseTrack

var target_volume = 0
const change_speed = 0.3

func _ready():
	main_track_player.play()

func _process(delta):
	var volume = main_track_player.volume_db
	
	var volume_change = (target_volume - volume) * delta * change_speed
	
	main_track_player.volume_db += volume_change
	tense_track_player.volume_db += volume_change

func set_target_volume(value):
	target_volume = value

func stop():
	main_track_player.stop()

func start():
	main_track_player.play()


func play_tense_track():
	#set_target_volume(-100)
	main_track_player.stop()
	tense_track_player.play()

#func _on_tense_track_finished():
	#main_track_player.play()
"

